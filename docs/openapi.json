  "components": {
    "schemas": {
      "CreatePaymentRequest": {
        "properties": {
          "customerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Customerid"
          },
          "sourceAccount": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{4,34}$",
            "title": "Sourceaccount"
          },
          "destinationAccount": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{4,34}$",
            "title": "Destinationaccount"
          },
          "amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount",
            "description": "US dollars, at most 2 decimals: 250.00 or \"250.00\""
          },
          "reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$",
            "title": "Reference"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customerId",
          "sourceAccount",
          "destinationAccount",
          "amount",
          "reference"
        ],
        "title": "CreatePaymentRequest",
        "examples": [
          {
            "amount": 250.0,
            "customerId": "C12345",
            "destinationAccount": "EXT98765",
            "reference": "PMT-1001",
            "sourceAccount": "VA10001"
          }
        ]
      },
      "CreateWebhookEndpointRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Url"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CreateWebhookEndpointRequest"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "EventsOut": {
        "properties": {
          "paymentId": {
            "type": "string",
            "title": "Paymentid"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/PaymentEventOut"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "paymentId",
          "events"
        ],
        "title": "EventsOut"
      },
      "LastError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
