    "/v1/payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Submit an ACH payment",
        "description": "Validates and queues the payment, then returns immediately with status PENDING.\nProcessing (the bank call, retries) happens in the background.",
        "operationId": "submit_payment_v1_payments_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required. Unique per payment; reuse only to retry the same request.",
              "title": "Idempotency-Key"
            },
            "description": "Required. Unique per payment; reuse only to retry the same request."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for asynchronous processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
