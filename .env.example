# Copy this file to .env and adjust. Every setting is validated at startup (app/config.py).
DATABASE_URL=postgresql://ach:ach@localhost:5432/ach
PORT=8000
LOG_LEVEL=INFO
BANK_BASE_URL=http://localhost:4000
BANK_TIMEOUT_MS=5000
WORKER_CONCURRENCY=4
MAX_ATTEMPTS=6
RETRY_BASE_MS=2000
JOB_LEASE_MS=60000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000
WEBHOOK_MAX_ATTEMPTS=8
# Keep true in production: blocks webhooks to private/internal addresses (SSRF protection).
WEBHOOK_BLOCK_PRIVATE_IPS=false
MOCK_BANK_FAILURE_RATE=0.1
